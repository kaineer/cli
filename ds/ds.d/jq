JSON=$(var ds.auth.json)
RAW=false
if [[ "$1" == "-r" ]]; then
  RAW=true
  shift
fi
QUERY="$1"

if [[ "$JSON" != "" ]] then
  if [[ "$QUERY" != "" ]] then
    if [[ "$RAW" == "true" ]] then
      echo "$JSON" | jq -r "$QUERY"
    else
      echo "$JSON" | jq "$QUERY"
    fi
  fi
fi

